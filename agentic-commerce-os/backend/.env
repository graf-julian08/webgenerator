# Agentic Commerce OS — Environment Variables
# Copy this to .env and fill in your keys

# LLM Provider: "nvidia" (default), "ollama", "vllm"
LLM_PROVIDER=nvidia

# NVIDIA API (Default — cloud inference)
NVIDIA_API_KEY=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

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
